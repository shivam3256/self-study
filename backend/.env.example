# StudyHub Backend Environment Variables

# Security
SECRET_KEY=supersecret-jwt-key-for-saas-self-study-platform-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default; supports postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL=sqlite+aiosqlite:///./study_center.db

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# Email & OTP Verification Configuration
# EMAIL_PROVIDER options: "console" (prints/logs in dev), "mock" (for tests), "smtp" (for production)
EMAIL_PROVIDER=console
EMAIL_FROM=StudyHub <noreply@studyhub.com>

# SMTP Settings (Required if EMAIL_PROVIDER=smtp, e.g. Brevo, Resend SMTP, AWS SES, Sendgrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True

# OTP Security Parameters
OTP_SECRET=studyhub-otp-secret-hmac-key-2026
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HOURLY_LIMIT=5
DEBUG_LOG_OTP=True

# WhatsApp Meta Cloud API Configuration
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0

# Platform Super Admin Configuration
# Hidden secret path prefix (do NOT share or use guessable prefixes like /admin)
ADMIN_PATH_PREFIX=/ops-k7x2q9m4
# Dedicated JWT secret key for platform admins (must differ from tenant SECRET_KEY)
ADMIN_SECRET_KEY=supersecret-admin-jwt-key-for-saas-platform-change-in-prod-2026
# Symmetric Fernet key for encrypting TOTP secrets at rest (32 url-safe base64 bytes)
ADMIN_FERNET_KEY=
# Token expirations
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional network hardening (comma-separated IPs or custom subdomain)
ADMIN_IP_ALLOWLIST=
ADMIN_SUBDOMAIN=
