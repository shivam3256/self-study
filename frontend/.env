# Frontend Environment Variables
# In production (Cloudflare Pages), set VITE_API_URL to your Render backend, e.g. https://your-service.onrender.com
# Keep empty locally to use Vite's dev proxy configured in vite.config.js
VITE_API_URL=

# Google OAuth 2.0 Client ID
# Get from: https://console.cloud.google.com/ -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=605671606228-nvva9vf0tqbhgua0708disdt95e0if97.apps.googleusercontent.com
